{
  "manifest_version": 3,
  "version": "2025.9.1",
  "name": "Invisible Voice",
  "description": "This extension boycotts a website",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "nativeMessaging",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://invisible-voice.com/*",
    "https://static.invisible-voice.com/*",
    "https://test.reveb.la/*",
    "https://assets.reveb.la/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_title": "invisible voice",
    "default_icons": {
      "16": "icon16.png",
      "24": "icon24.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "96": "icon96.png",
      "128": "icon128.png"
    },
    "browser_style": true,
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "24": "icon24.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "replacements.json",
        "public_suffix_list.dat",
        "sitetohash.json",
        "hashtosite.json",
        "auth_helper.js",
        "auth_helper.js",
        "blocked.html",
        "sitelistblock.html",
        "sitelistblock.js",
        "logoShow.png",
        "button.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js""service_worker": "background.js"
  },
  "incognito": "split",
  "incognito": "split",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "helper.js",
        "InvisibleVoice.js"
      ],
      "css": [
        "InvisibleVoice.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "admin@invisible-voice.com",
      "strict_min_version": "120.0"
    }
  }
}